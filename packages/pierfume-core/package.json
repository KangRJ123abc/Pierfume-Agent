{
  "name": "pierfume-core",
  "version": "0.1.0",
  "description": "Pierfume Agent — 调香师副驾驶核心 Pi package:配方工作台、formula-lint、ifra-check",
  "keywords": ["pi-package", "flavor", "fragrance", "ifra", "perfumery"],
  "license": "MIT",
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"]
  },
  "scripts": {
    "validate-data": "node scripts/validate-data.mjs",
    "validate-data:self": "node scripts/validate-data.mjs --selftest",
    "validate-formula": "node scripts/validate-formula.mjs",
    "validate-formula:self": "node scripts/validate-formula.mjs -- examples/formula.example.yaml",
    "check-ifra": "node scripts/ifra-check.mjs",
    "diff-formula": "node scripts/formula-diff.mjs",
    "demo": "node demo/server.mjs",
    "test": "node tests/formula-lint.e2e.mjs && node tests/ifra-check.e2e.mjs && node tests/formula-diff.e2e.mjs",
    "test:formula-lint": "node tests/formula-lint.e2e.mjs",
    "test:ifra-check": "node tests/ifra-check.e2e.mjs",
    "test:formula-diff": "node tests/formula-diff.e2e.mjs"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
